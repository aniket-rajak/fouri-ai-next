# ====================
# FOURI.IN Backend — Production Environment Variables
# ====================

# Database
DATABASE_URL="postgresql://user:password@host:5432/fouri?schema=public"

# Firebase Admin SDK
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Google Vision API (JSON string of service account)
GOOGLE_VISION_CREDENTIALS='{"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}'

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"

# Sentry
SENTRY_DSN="https://your-dsn@oXXXX.ingest.us.sentry.io/XXXXX"

# Server
PORT=4000
NODE_ENV=production
CORS_ORIGIN="https://fouri.in"

# Owner Console Credentials (MUST be set via env vars on Railway)
OWNER_EMAIL=your-owner-email@example.com
OWNER_PASSWORD=your-owner-password

# SMTP (Hostinger Email)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=office@fouri.in
SMTP_PASS=your-smtp-password
SMTP_FROM=office@fouri.in

# JWT (for admin sessions)
JWT_SECRET="your-strong-random-jwt-secret"

# Telegram Bot (File Storage)
TELEGRAM_BOT_TOKEN="your-bot-token-from-botfather"
TELEGRAM_CHANNEL_ID="your-channel-id"
