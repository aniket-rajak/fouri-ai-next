# ====================
# FOURI.IN Backend — Production Environment Variables
# ====================

# Database
DATABASE_URL="postgresql://user:password@host:5432/fouri?schema=public"

# Firebase Admin SDK
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Google Vision API (JSON string of service account)
GOOGLE_VISION_CREDENTIALS='{"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}'

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"

# Sentry
SENTRY_DSN="https://your-dsn@oXXXX.ingest.us.sentry.io/XXXXX"

# Server
PORT=4000
NODE_ENV=production
CORS_ORIGIN="https://fouri.in"

# JWT
JWT_SECRET="your-random-secret-key"
