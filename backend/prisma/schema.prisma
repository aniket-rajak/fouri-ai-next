generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UploadStatus {
  PROCESSING
  ANALYZING
  COMPLETED
  FAILED
}

enum TestStatus {
  DRAFT
  PUBLISHED
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  TIMEOUT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MCQ
  SUBJECTIVE
}

model User {
  id         String   @id @default(uuid())
  firebaseUid String  @unique
  email      String   @unique
  name       String?
  avatarUrl  String?
  role       Role     @default(USER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  uploads      Upload[]
  testAttempts TestAttempt[]
}

model Upload {
  id           String       @id @default(uuid())
  userId       String
  filename     String
  fileType     String
  fileSize     Int?
  cloudinaryUrl String?
  status       UploadStatus @default(PROCESSING)
  createdAt    DateTime     @default(now())

  user      User       @relation(fields: [userId], references: [firebaseUid], onDelete: Cascade)
  mockTests MockTest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model MockTest {
  id              String     @id @default(uuid())
  title           String
  subject         String?
  chapter         String?
  examType        String?
  difficulty      Difficulty @default(MEDIUM)
  duration        Int        @default(1800)
  totalQuestions  Int        @default(0)
  sourceUploadId  String?
  status          TestStatus @default(DRAFT)
  attemptCount    Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sourceUpload Upload?       @relation(fields: [sourceUploadId], references: [id])
  questions    Question[]
  attempts     TestAttempt[]

  @@index([subject])
  @@index([examType])
  @@index([status])
  @@index([status, createdAt])
}

model Question {
  id            String       @id @default(uuid())
  mockTestId    String
  questionText  String
  options       Json
  correctAnswer String
  type          QuestionType @default(MCQ)
  difficulty    Difficulty   @default(MEDIUM)
  order         Int
  createdAt     DateTime     @default(now())

  mockTest     MockTest      @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  answers      Answer[]
  explanations Explanation[]

  @@index([mockTestId])
}

model TestAttempt {
  id         String        @id @default(uuid())
  userId     String
  mockTestId String
  status     AttemptStatus @default(IN_PROGRESS)
  score      Int?
  totalMarks Int?
  accuracy   Float?
  timeTaken  Int?
  startedAt  DateTime      @default(now())
  completedAt DateTime?

  user     User       @relation(fields: [userId], references: [firebaseUid], onDelete: Cascade)
  mockTest MockTest   @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@index([userId])
  @@index([mockTestId])
  @@index([userId, mockTestId])
  @@index([startedAt])
  @@index([userId, status])
}

model Answer {
  id              String  @id @default(uuid())
  testAttemptId   String
  questionId      String
  selectedOption  String?
  isCorrect       Boolean?
  timeSpent       Int?

  testAttempt TestAttempt @relation(fields: [testAttemptId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testAttemptId, questionId])
  @@index([testAttemptId])
  @@index([questionId])
}

model Explanation {
  id                String   @id @default(uuid())
  questionId        String   @unique
  shortExplanation  String?
  detailedExplanation String?
  createdAt         DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String
  excerpt   String?
  imageUrl  String?
  author    String   @default("FOURI Team")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([published])
  @@index([createdAt])
}

model Ad {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String
  ctaText     String   @default("Learn More")
  ctaLink     String
  blogUrl     String?
  active      Boolean  @default(true)
  clicks      Int      @default(0)
  impressions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}
